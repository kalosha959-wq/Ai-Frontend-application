{
  "name": "ai-story-studio-backend",
  "version": "1.0.1",
  "description": "Backend server for the Ai Story Studio application.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "npx eslint . --ext .js,.html",
    "format": "npx prettier --write .",
    "test": "jest --runInBand",
    "audit": "npm audit || true",
    "docker:build": "docker build -t ai-story-studio .",
    "docker:run": "docker run -p 3000:3000 -e GEMINI_API_KEY=demo-mode -e GCP_PROJECT_ID=demo-project ai-story-studio",
    "release": "./scripts/release.sh"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/vertexai": "^0.3.0",
    "axios": "^1.7.2",
    "chalk": "^4.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "puppeteer": "^24.15.0",
    "helmet": "^7.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "eslint": "^8.47.0",
    "prettier": "^2.10.0",
    "jest": "^29.6.0",
    "supertest": "^6.4.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalosha959-wq/Ai-Frontend-application.git"
  },
  "bugs": {
    "url": "https://github.com/kalosha959-wq/Ai-Frontend-application/issues"
  },
  "homepage": "https://github.com/kalosha959-wq/Ai-Frontend-application#readme",
  "keywords": [
    "ai",
    "story",
    "backend",
    "nodejs",
    "express",
    "vertex-ai",
    "video-generation"
  ]
}
