# AI Story Studio - Environment Configuration
# DO NOT share this file or commit it to GitHub.

# =============================================================================
# ESSENTIAL API KEYS (Required for the application to work)
# =============================================================================

# Gemini AI API Key - Demo mode for testing
GEMINI_API_KEY="demo-mode"

# Google Cloud Project Configuration  
GCP_PROJECT_ID="demo-project"
GCP_LOCATION="us-central1"

# =============================================================================
# SERVER CONFIGURATION (Optional)
# =============================================================================
PORT=3000

# =============================================================================
# INSTRUCTIONS FOR REAL API SETUP (When ready)
# =============================================================================
# 1. Get your Gemini API key from Google AI Studio
# 2. Replace "demo-mode" with your actual API key
# 3. Replace "demo-project" with your Google Cloud Project ID
#
# Example:
# GEMINI_API_KEY="AIzaSyD_your_actual_key_here"
# GCP_PROJECT_ID="your-actual-gcp-project-id"
#
# =============================================================================
# END OF CONFIGURATION
# =============================================================================

