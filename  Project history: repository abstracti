// Project history: repository abstraction so we can swap localStorage for backend later
const HISTORY_KEY = 'aiStoryStudioProjectHistory';

// Helper: generate a stable-ish id if caller didn't provide one
function generateId() {
  // simple timestamp + random suffix
  return `proj-${Date.now()}-${Math.floor(Math.random() * 1e6)}`;
}

function hasLocalStorage() {
  try {
    return typeof localStorage !== 'undefined' && localStorage !== null;
  } catch (err) {
    return false;
  }
}

const ProjectHistoryRepo = {
  async list() {
    // For now, use localStorage; later, this can call a backend API instead.
    try {
      if (!hasLocalStorage()) return [];
      const raw = localStorage.getItem(HISTORY_KEY);
      if (!raw) return [];
      const parsed = JSON.parse(raw);
      return Array.isArray(parsed) ? parsed : [];
    } catch (err) {
      console.error('Failed to read history from localStorage', err);
      return [];
    }
  },

  async save(newItem) {
    // newItem: { id, prompt, duration, createdAt, completedAt?, videoUrl?, planHtml? }
    try {
      if (!newItem) throw new Error('No item provided to save');

      // Ensure an id and createdAt exist
      const itemToSave = {
        ...newItem,
        id: newItem.id || generateId(),
        createdAt: newItem.createdAt || new Date().toISOString()
      };

      // Use direct reference to ProjectHistoryRepo.list to avoid `this` binding issues
      const existing = await ProjectHistoryRepo.list();
      const withoutDup = existing.filter(item => item && item.id !== itemToSave.id);
      const updated = [itemToSave, ...withoutDup].slice(0, 20); // keep last 20

      if (hasLocalStorage()) {
        try {
          localStorage.setItem(HISTORY_KEY, JSON.stringify(updated));
        } catch (err) {
          console.error('Failed to write history to localStorage', err);
          // still return updated in-memory result
        }
      }

      return updated;
    } catch (err) {
      console.error('Failed to save history to localStorage', err);
      return [];
    }
  }
};

async function loadProjectHistory() {
  const historyItems = await ProjectHistoryRepo.list();
  renderProjectHistory(historyItems);
}

async function saveProjectHistory(projectMeta) {
  const updatedItems = await ProjectHistoryRepo.save(projectMeta);
  renderProjectHistory(updatedItems);
}

// Helper for click handlers that just need the latest list
async function getHistoryItems() {
  return await ProjectHistoryRepo.list();
}

// Renders project history into an element with id="projectHistory" if present,
// otherwise logs the items; safe DOM creation to avoid XSS and undefined symbols.
function renderProjectHistory(items) {
  try {
    const el = (typeof document !== 'undefined') && document.getElementById('projectHistory');
    if (!el) {
      // No DOM target available (e.g., server-side or tests), just log for visibility.
      console.debug('renderProjectHistory:', items);
      return;
    }

    el.innerHTML = '';

    if (!Array.isArray(items) || items.length === 0) {
      const p = document.createElement('p');
      p.textContent = 'No projects yet.';
      el.appendChild(p);
      return;
    }

    items.forEach(it => {
      const itemEl = document.createElement('div');
      itemEl.className = 'history-item';
      if (it && it.id) itemEl.dataset.id = it.id;

      const title = document.createElement('div');
      title.className = 'history-title';
      title.textContent = (it && it.prompt) ? it.prompt : 'Untitled';

      const meta = document.createElement('div');
      meta.className = 'history-meta';
      meta.textContent = (it && it.createdAt) ? new Date(it.createdAt).toLocaleString() : '';

      itemEl.appendChild(title);
      itemEl.appendChild(meta);
      el.appendChild(itemEl);
    });
  } catch (err) {
    console.error('Failed to render project history', err);
  }
}

