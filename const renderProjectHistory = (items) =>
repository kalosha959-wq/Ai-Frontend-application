const renderProjectHistory = (items) => {
    projectHistoryList.innerHTML = '';
    if (!items || items.length === 0) {
        projectHistoryEmpty.classList.remove('hidden');
        // maybe old code also appended projectHistoryEmpty to list
        return;
    }
    projectHistoryEmpty.classList.add('hidden');
    items.forEach((item, index) => {
        const li = document.createElement('li');
        li.className = 'flex items-center justify-between bg-gray-900/40 border border-gray-700 rounded-lg px-3 py-2';
        li.innerHTML = `
            <div class="mr-2">
                <div class="text-xs text-gray-400">#${index + 1} • ${new Date(item.createdAt || item.completedAt || Date.now()).toLocaleString()}</div>
                <div class="text-sm font-medium text-gray-100 truncate max-w-[180px]" title="${item.prompt}">${item.prompt}</div>
                <div class="text-xs text-gray-400">${item.duration || 'N/A'}s</div>
            </div>
            <div class="flex items-center gap-2">
                <button class="text-xs px-2 py-1 rounded border border-gray-600 text-gray-200 hover:bg-gray-800" data-history-action="viewPlan" data-index="${index}">
                    Plan
                </button>
                <button class="text-xs px-2 py-1 rounded border border-gray-600 text-gray-200 hover:bg-gray-800" data-history-action="viewVideo" data-index="${index}">
                    Video
                </button>
            </div>
        `;
        projectHistoryList.appendChild(li);
    });
};